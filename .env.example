# Application Configuration
APP_NAME="AYUSH EMR Terminology Microservice"
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration
POSTGRES_USER=ayush_user
POSTGRES_PASSWORD=ayush_password
POSTGRES_DB=ayush_terminology_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ayush_user:ayush_password@db:5432/ayush_terminology_db

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_secret_key_in_production

# ABHA OAuth 2.0 (Ayushman Bharat Health Account)
# Leave ABHA_INTROSPECT_URL empty to use MockABHAProvider (development only)
ABHA_INTROSPECT_URL=
ABHA_CLIENT_ID=
ABHA_CLIENT_SECRET=
# Mock token for local development and CI tests
ABHA_MOCK_TOKEN=test-mock-token

# WHO ICD-11 MMS API Configuration
# Set WHO_USE_MOCK=false and populate credentials to connect to production WHO ICD-11 API
WHO_USE_MOCK=true
WHO_API_URL=https://id.who.int/icd/release/11/mms
WHO_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
WHO_CLIENT_ID=
WHO_CLIENT_SECRET=
